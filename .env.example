# ---------------------------------------------------------------------------
# Supabase
#
# En local salen de `npx supabase status`; `npm run db:env` los escribe en
# .env.local por ti. En Vercel se ponen a mano: ver DESPLIEGUE.md.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave de servicio se salta Row Level Security: lee y escribe todo.
#
# Solo en el servidor. No lleva el prefijo NEXT_PUBLIC_ y por eso Next no la
# manda al navegador; ponérselo la publicaría a cualquiera que abra la
# página. En Vercel, solo en el entorno de producción.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# Para `npm run informes` contra un despliegue en vez de contra localhost
# APP_URL=https://plataforma.inceptionwomanlab.es

# Correo transaccional: enlaces de recuperación y alertas del paso 14
# RESEND_API_KEY=
