# Supabase. En local salen de `npx supabase status`; el script `npm run db:env`
# los escribe en .env.local por ti.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio. Solo en servidor y en el worker. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Correo transaccional (fase 2)
RESEND_API_KEY=
